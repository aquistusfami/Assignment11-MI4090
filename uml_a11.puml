@startuml uml_a11
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Geist
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45
hide circle
hide empty members

interface ISensor
{
  + ReadValue(): double
  + GetUnit(): string
}

class LegacySmokeDetector <<sealed>>
{
  - smokeLevel: int
  + LegacySmokeDetector(smokeLevel: int)
  + GetSmokeLevel(): int
  + GetDescription(): string
  + SetSmokeLevel(value: int): void
}

class SmokeSensorAdapter
{
  - legacy: LegacySmokeDetector
  + SmokeSensorAdapter(legacy: LegacySmokeDetector)
  + ReadValue(): double
  + GetUnit(): string
}

class AlertEvent <<record>>
{
  + SensorName: string
  + Value: double
  + Unit: string
  + Severity: string
  + OccurredAt: DateTime
}

interface IAlertObserver
{
  + Update(alertEvent: AlertEvent): void
}

class SensorMonitor
{
  - observers: List<IAlertObserver>
  + Attach(observer : IAlertObserver): void
  + Detach(observer : IAlertObserver): void
  + CheckSensor(sensorName: string, sensor: ISensor): void
  - Notify (alertEvent : AlertEvent): void 
}

class EmergencyBridgeObserver
{
  - mediator : IEmergencyMediator
  + EmergencyBridgeObserver(mediator : IEmergencyMediator)
  + Update(alertEvent : AlertEvent) : void
}

interface IEmergencyMediator
{
  + Notify(sender : object, eventCode : string): void
}

class EmergencyMediator
{
  - alarm : Alarm
  - door : DoorController
  - ventilation : VentilationController

  + EmergencyMediator(alarm : Alarm, door : DoorController, ventilation  : VentilationController)
  + Notify(sender : object, eventCode : string) : void
}

class DashboardObserver
{
  + Update(alertEvent : AlertEvent) : void
}

class EmailAlertObserver
{
  + Update(alertEvent : AlertEvent) : void
}

class AuditLogObserver
{
  + Update(alertEvent : AlertEvent) : void
}

class Alarm
{
  - mediator : IEmergencyMediator?
  + SetMediator(mediator : IEmergencyMediator) : void
  + Trigger() : void
  + Reset() : void
}

class DoorController
{
  - mediator : IEmergencyMediator?
  + SetMediator(mediator : IEmergencyMediator) : void
  + UnlockAll() : void
  + LockAll() : void
}

class VentilationController
{
  - mediator : IEmergencyMediator?
  + SetMediator(mediator : IEmergencyMediator) : void
  + Shutdown() : void
  + Start() : void
}

AlertEvent <.. SensorMonitor : creates
AlertEvent <.. IAlertObserver : receives
SensorMonitor o-> IAlertObserver : observers
DashboardObserver ..|> IAlertObserver
EmailAlertObserver ..|> IAlertObserver
AuditLogObserver ..|> IAlertObserver
EmergencyBridgeObserver ..|> IAlertObserver

LegacySmokeDetector --o SmokeSensorAdapter : has-a
SmokeSensorAdapter ..|> ISensor : implements
SensorMonitor ..> ISensor : receives

EmergencyMediator ..|> IEmergencyMediator : implements
EmergencyBridgeObserver --> IEmergencyMediator : delegates to

EmergencyMediator ..|> IEmergencyMediator : implements
EmergencyMediator o--> Alarm
EmergencyMediator o--> DoorController
EmergencyMediator o--> VentilationController
Alarm --> IEmergencyMediator : notifies
DoorController --> IEmergencyMediator : notifies
VentilationController --> IEmergencyMediator : notifies
@enduml
